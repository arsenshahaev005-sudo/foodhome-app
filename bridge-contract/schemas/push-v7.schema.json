{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodhome.market/contracts/native-push/v7/payload.schema.json",
  "title": "FoodHome Android buyer activity visible data-only push v7",
  "type": "object",
  "required": [
    "version",
    "eventType",
    "eventId",
    "bindingId",
    "expiresAt",
    "route"
  ],
  "properties": {
    "version": {
      "const": 7
    },
    "eventType": {
      "const": "buyer.notification"
    },
    "eventId": {
      "$ref": "#/$defs/uuid"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "protocol",
            "version",
            "name",
            "params",
            "query"
          ],
          "properties": {
            "protocol": {
              "const": "foodhome.logical-route"
            },
            "version": {
              "const": 1
            },
            "name": {
              "const": "notifications.inbox"
            },
            "params": {
              "$ref": "#/$defs/empty"
            },
            "query": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "CLIENT"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "protocol",
            "version",
            "name",
            "params",
            "query"
          ],
          "properties": {
            "protocol": {
              "const": "foodhome.logical-route"
            },
            "version": {
              "const": 1
            },
            "name": {
              "const": "order.detail"
            },
            "params": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/uuid"
                }
              },
              "additionalProperties": false
            },
            "query": {
              "$ref": "#/$defs/empty"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "empty": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
