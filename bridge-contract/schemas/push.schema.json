{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodhome.market/contracts/native-push/v2/payload.schema.json",
  "title": "FoodHome Android visible push application payload v2 (activation gated)",
  "type": "object",
  "required": ["version", "eventType", "eventId", "bindingId", "expiresAt", "route"],
  "properties": {
    "version": { "const": 2 },
    "eventType": { "enum": ["order.updated", "chat.message"] },
    "eventId": { "$ref": "#/$defs/uuid" },
    "bindingId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "route": {
      "type": "object",
      "required": ["protocol", "version", "name", "params", "query"],
      "properties": {
        "protocol": { "const": "foodhome.logical-route" },
        "version": { "const": 1 },
        "name": { "enum": ["order.detail", "chat.inbox"] },
        "params": { "type": "object" },
        "query": { "type": "object" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "name": { "const": "order.detail" },
            "params": {
              "type": "object", "required": ["id"],
              "properties": { "id": { "$ref": "#/$defs/uuid" } }, "additionalProperties": false
            },
            "query": { "$ref": "#/$defs/empty" }
          }
        },
        {
          "properties": {
            "name": { "const": "chat.inbox" },
            "params": { "$ref": "#/$defs/empty" },
            "query": {
              "type": "object", "maxProperties": 1,
              "properties": { "orderId": { "$ref": "#/$defs/uuid" }, "producerId": { "$ref": "#/$defs/uuid" } },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "order.updated" } } },
      "then": { "properties": { "route": { "type": "object", "properties": { "name": { "const": "order.detail" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "chat.message" } } },
      "then": { "properties": { "route": { "type": "object", "properties": { "name": { "const": "chat.inbox" } } } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "empty": { "type": "object", "maxProperties": 0, "additionalProperties": false }
  }
}
